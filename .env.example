# Foundry resource endpoint (Azure portal > your Foundry resource > Keys and Endpoint)
FOUNDRY_RESOURCE_ENDPOINT=https://<your-resource>.services.ai.azure.com/
# Foundry project endpoint (Foundry portal > project Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# Optional. Leave empty to use Microsoft Entra ID (az login). Never commit a real key.
FOUNDRY_KEY=
# Model deployments (Step 2 and Step 6 of the README)
DEPLOYMENT_BASE=gpt-4.1-mini
DEPLOYMENT_GUARDED=gpt-4.1-mini-guarded
# Content Understanding analyzer used for extraction
CU_ANALYZER=prebuilt-layout
